{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minuteman",
  "mainBinaryName": "Minuteman",
  "version": "0.1.0",
  "identifier": "com.lukesassa.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Minuteman",
        "width": 1100,
        "height": 780,
        "minWidth": 340,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://photon.komoot.io https://api.zippopotam.us; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.macos.plist",
      "entitlements": "Entitlements.macos.plist"
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.googleusercontent.apps.454006958306-jt3q1gtalsp37n0r1bkkn6nputgu3ab4"],
          "appLink": false
        }
      ]
    }
  }
}
